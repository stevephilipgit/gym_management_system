# NODE ENVIRONMENT
NODE_ENV=development

# Server Configuration
PORT=5000

# Database Configuration
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/gym_db?retryWrites=true&w=majority

# Redis Configuration (Optional)
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-secret-key-here-change-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# AI Configuration (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
AI_ENABLED=true

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_DEFAULT_MAX=100
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_OTP_MAX=3

# Email Configuration (if applicable)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# File Upload Configuration
MAX_FILE_SIZE=52428800
UPLOAD_DIR=uploads

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# Frontend Configuration (if needed)
VITE_API_URL=http://localhost:5000/api
VITE_APP_NAME=Gym Management System
