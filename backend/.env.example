# ── App ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ─────────────────────────────────────────────────────────
# REQUIRED
DATABASE_URL=

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth / JWT ────────────────────────────────────────────────────────
# REQUIRED — server will not start without JWT_ACCESS_SECRET
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Encryption ────────────────────────────────────────────────────────
# REQUIRED — server will not start without this
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
FIELD_ENCRYPTION_KEY=

# ── CORS ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── AI (Gemini) ───────────────────────────────────────────────────────
# Optional — AI features disabled if AI_ENABLED=false or key missing
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── Email / SMTP ──────────────────────────────────────────────────────
# Optional — email features disabled if any SMTP value is missing
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=Giri Gym <your@gmail.com>

# ── Google Sheets ─────────────────────────────────────────────────────
# Optional — sheets sync disabled if any Google value is missing
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# GOOGLE_SHEET_ID=
