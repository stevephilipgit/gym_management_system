# ── App ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ─────────────────────────────────────────────────────────
# REQUIRED
DATABASE_URL=

# Local setup scripts (required only when running src/createAdmin.js or src/seed.js)
CREATE_ADMIN_PASSWORD=
SEED_SUPERADMIN_PASSWORD=
SEED_TRAINER_PASSWORD=

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth / JWT ────────────────────────────────────────────────────────
# REQUIRED — server will not start without JWT_ACCESS_SECRET
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Encryption ────────────────────────────────────────────────────────
# REQUIRED — server will not start without this
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
FIELD_ENCRYPTION_KEY=

# ── CORS ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── AI (Gemini) ───────────────────────────────────────────────────────
# Optional — AI features disabled if AI_ENABLED=false or key missing
AI_ENABLED=false

# Primary provider
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
AI_API_KEY=
# Backwards-compatible alias (used when AI_API_KEY is empty)
GEMINI_API_KEY=

# Fallback provider (optional — any OpenAI-compatible endpoint works)
# AI_FALLBACK_PROVIDER=openai-compat
# AI_FALLBACK_MODEL=gpt-4o-mini
# AI_FALLBACK_API_KEY=
# AI_FALLBACK_BASE_URL=https://api.openai.com/v1

# AI behavior
AI_TIMEOUT_MS=15000
AI_RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_PER_HOUR=100
AI_MAX_MESSAGE_LENGTH=2000
AI_MAX_HISTORY_PAIRS=10
AI_MAX_CONTEXT_LENGTH=10000
AI_MAX_MEMORY_ITEMS=50

# ── Email / SMTP ──────────────────────────────────────────────────────
# Optional — email features disabled if any SMTP value is missing
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=Giri Gym <your@gmail.com>

# ── Google Sheets ─────────────────────────────────────────────────────
# Optional — sheets sync disabled if any Google value is missing
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# GOOGLE_SHEET_ID=
